{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Influx": {
    "Url": "",
    "Token": "",
    "Org": "",
    "Bucket": ""
  },
  "WeatherApi": {
    "BaseUrl": "",
    "ApiKey": "",
    "ReadingsPath": "readings",
    "ApiKeyHeaderName": "X-Api-Key"
  },
  "AllowedHosts": "*"
}
