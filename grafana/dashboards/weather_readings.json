{
  "uid": "weather-readings",
  "title": "Weather Readings",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["weather", "influx"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Average Sensor Value (last 1h)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "query": "from(bucket: \"readings\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"weather_reading\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: 1m, fn: mean)\n  |> yield(name: \"mean\")",
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Netatmo",
      "description": "Netatmo OAuth status. Use the login link when not connected.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "weatherstation-api"
      },
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "weatherstation-api" },
          "type": "json",
          "source": "url",
          "url": "http://api:8080/api/v1/netatmo/status",
          "format": "table",
          "root_selector": "",
          "url_options": { "method": "GET" }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "authenticated": true, "expiresAtUtc": true },
            "renameByName": { "loginUrl": "Action" }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Action" },
            "properties": [
              { "id": "links", "value": [{ "title": "Login", "url": "${__value.raw}" }] }
            ]
          }
        ]
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
